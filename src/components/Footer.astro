---
import { ArrowUpRight } from '@lucide/astro'
import { site } from '@/lib/site'
import StatusBadge from '@/components/StatusBadge.astro'
import Wordmark from '@/components/Wordmark.astro'
import LanguageSwitcher from '@/components/LanguageSwitcher.astro'
import { localizePath, t, type Locale } from '@/i18n'

interface Props {
  lang: Locale
  path: string
  alternates?: { lang: Locale; path: string }[]
}

const { lang, path, alternates } = Astro.props
const strings = t(lang)
const nav = [
  { label: strings.nav.work, to: '/work' },
  { label: strings.nav.about, to: '/about' },
  { label: strings.nav.hiring, to: '/hiring' },
  { label: strings.nav.blog, to: '/blog' },
  { label: strings.nav.contact, to: '/contact' },
]
const href = (to: string) => localizePath(to, lang)

const year = new Date().getFullYear()
---

<footer class="border-t border-line bg-surface">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <Wordmark class="text-xl" />
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
          {strings.common.footerTagline}{' '}
          {strings.common.footerRemote
            .replace('{location}', strings.common.location)
            .replace('{timezone}', site.timezone)}
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-4">
          <StatusBadge lang={lang} />
          <LanguageSwitcher lang={lang} path={path} alternates={alternates} />
        </div>
      </div>

      <div>
        <p class="mono-label">{strings.common.sitemap}</p>
        <ul class="mt-4 flex flex-col gap-2.5">
          {
            nav.map((item) => (
              <li>
                <a href={href(item.to)} class="text-sm text-muted transition-colors hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/rss.xml" class="inline-flex items-center gap-1 text-sm text-muted transition-colors hover:text-ink">
              {strings.common.rssFeed}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="mono-label">{strings.common.direct}</p>
        <ul class="mt-4 flex flex-col gap-2.5">
          <li>
            <a
              href={site.social.email}
              class="inline-flex items-center gap-1 text-sm text-muted transition-colors hover:text-ink"
            >
              {site.email}
            </a>
          </li>
          <li>
            <a
              href={site.social.github}
              rel="me noopener"
              class="inline-flex items-center gap-1 text-sm text-muted transition-colors hover:text-ink"
            >
              GitHub <ArrowUpRight class="size-3.5" />
            </a>
          </li>
          <li>
            <a
              href={site.social.linkedin}
              rel="me noopener"
              class="inline-flex items-center gap-1 text-sm text-muted transition-colors hover:text-ink"
            >
              LinkedIn <ArrowUpRight class="size-3.5" />
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col justify-between gap-3 border-t border-line pt-6 sm:flex-row">
      <p class="font-mono text-[0.7rem] uppercase tracking-wide text-muted">
        © {year} {site.brandFull} · {site.owner}
      </p>
      <p class="font-mono text-[0.7rem] uppercase tracking-wide text-muted">
        {strings.common.location} · {site.timezone}
      </p>
    </div>
  </div>
</footer>
