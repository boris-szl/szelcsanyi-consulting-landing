---
/*
  Switches between the two locales for the *current* page rather than sending
  everyone to the homepage — landing on /de after clicking "DE" from a project
  page is the single most annoying thing a language switcher can do.

  Not every page exists in both languages: a blog post is only translated if
  someone wrote the translation. `alternates` therefore carries the URLs that
  actually exist, and anything missing falls back to `fallback` (the section
  index) rather than linking confidently at a 404.
*/
import { LOCALES, LOCALE_NAME, LOCALE_SHORT, localizePath, t, type Locale } from '@/i18n'
import { cn } from '@/lib/utils'

interface Props {
  lang: Locale
  /** Path without a locale prefix, e.g. "/work/onduty". */
  path: string
  /** Locale variants known to exist. Defaults to "the same path in both". */
  alternates?: { lang: Locale; path: string }[]
  class?: string
}

const { lang, path, alternates, class: className } = Astro.props
const strings = t(lang)

/*
  With no explicit list, assume the page exists at the same path in both
  locales — true for every page except blog posts, which pass their own.
*/
const known = new Map(
  (alternates ?? LOCALES.map((locale) => ({ lang: locale, path: localizePath(path, locale) }))).map(
    (alt) => [alt.lang, alt.path],
  ),
)

/** Nearest sensible landing place when a translation does not exist. */
function fallbackFor(locale: Locale): string {
  const section = path.startsWith('/blog') ? '/blog' : '/'
  return localizePath(section, locale)
}
---

<div
  class={cn('flex items-center gap-1 font-mono text-[0.7rem] uppercase tracking-wide', className)}
  role="group"
  aria-label={strings.nav.language}
>
  {
    LOCALES.map((locale, i) => (
      <>
        {i > 0 && <span class="text-line" aria-hidden="true">/</span>}
        {locale === lang ? (
          <span class="px-1 text-ink" aria-current="true" lang={locale}>
            {LOCALE_SHORT[locale]}
          </span>
        ) : (
          <a
            href={known.get(locale) ?? fallbackFor(locale)}
            hreflang={known.has(locale) ? locale : undefined}
            lang={locale}
            class="px-1 text-muted transition-colors hover:text-accent"
            aria-label={LOCALE_NAME[locale]}
            title={known.has(locale) ? undefined : strings.common.noTranslation}
          >
            {LOCALE_SHORT[locale]}
          </a>
        )}
      </>
    ))
  }
</div>
