---
// A spec-reference eyebrow — the § marker encodes a real section index,
// echoing the "datasheet" language used across the site.
interface Props {
  mark: string
}

const { mark } = Astro.props
---

<div class="flex items-center gap-3">
  <span class="mono-label text-accent">{mark}</span>
  <span class="h-px w-8 bg-line" aria-hidden="true"></span>
  <span class="mono-label"><slot /></span>
</div>
