---
/*
  Every page's <head>. Emits the canonical URL, Open Graph / Twitter cards, and
  one schema.org @graph combining the site-wide identity nodes with whatever
  primary node the page passes in.
*/
import { config } from '@/config'
import { abs, websiteNode, personNode, businessNode, type Node } from '@/lib/meta'

interface Props {
  title: string
  description: string
  /** Append the brand to the title. Off for the home page, which carries it. */
  brandSuffix?: boolean
  ogType?: 'website' | 'article' | 'profile'
  image?: string
  noindex?: boolean
  /** Page-specific schema.org nodes, merged into the shared @graph. */
  jsonLd?: Node[]
  article?: { publishedTime: string; modifiedTime?: string; tags?: string[] }
  lang?: 'en' | 'de'
  /** Other language versions of this page, for hreflang. */
  alternates?: { lang: 'en' | 'de'; path: string }[]
}

const {
  title,
  description,
  brandSuffix = true,
  ogType = 'website',
  image = '/og.png',
  noindex = false,
  jsonLd = [],
  article,
  lang = 'en',
  alternates = [],
} = Astro.props

/*
  Google truncates titles around 60 characters. The brand suffix costs 24 of
  them, so it is appended only when the result still fits — otherwise the
  page's own words win, which are the ones worth showing.
*/
const TITLE_BUDGET = 60
const DESCRIPTION_BUDGET = 160

/*
  A backstop, not a substitute for writing a good description: pages that care
  should pass one inside the budget. This only stops an over-long entity
  summary from being cut mid-word by the search engine instead.
*/
function clamp(text: string, max: number): string {
  if (text.length <= max) return text
  const cut = text.slice(0, max - 1)
  return `${cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:—-]$/, '')}…`
}
const withBrand = `${title} — ${config.brandFull}`
const fullTitle = brandSuffix && withBrand.length <= TITLE_BUDGET ? withBrand : title
/*
  Astro.url carries the configured `site`, so this is already absolute. Strip
  the trailing slash to match `trailingSlash: 'never'` — except on the root,
  where the origin alone is not a valid URL path.
*/
const path = Astro.url.pathname
const canonical =
  path === '/' ? Astro.site!.href : new URL(path, Astro.site).href.replace(/\/$/, '')
const ogImage = abs(image)
const metaDescription = clamp(description, DESCRIPTION_BUDGET)

const graph = noindex ? [] : [websiteNode(), personNode(), businessNode(), ...jsonLd]
---

<title>{fullTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonical} />
<meta name="author" content={config.owner} />
<meta
  name="robots"
  content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
/>

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={config.brandFull} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en'} />

{
  /*
    hreflang must be reciprocal and include the page itself, or Google ignores
    the set. x-default points at the English version as the canonical entry.
  */
  alternates.length > 0 && (
    <>
      {/* The set includes this page itself; emitting it twice is invalid. */}
      {alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.lang} href={abs(alt.path)} />
      ))}
      <link
        rel="alternate"
        hreflang="x-default"
        href={lang === 'en' ? canonical : abs(alternates.find((a) => a.lang === 'en')?.path ?? '/')}
      />
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage} />

{article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
{article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

{
  graph.length > 0 && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
    />
  )
}
