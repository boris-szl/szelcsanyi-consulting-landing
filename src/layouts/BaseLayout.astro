---
import '@fontsource-variable/outfit'
import '@fontsource-variable/geist-mono'
import '@/index.css'
import Seo from '@/components/Seo.astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import type { Node } from '@/lib/meta'
import { alternatesFor, localeOf, localizePath, t, type Locale } from '@/i18n'

interface Props {
  title: string
  description: string
  brandSuffix?: boolean
  ogType?: 'website' | 'article' | 'profile'
  image?: string
  noindex?: boolean
  jsonLd?: Node[]
  article?: { publishedTime: string; modifiedTime?: string; tags?: string[] }
  lang?: Locale
  alternates?: { lang: Locale; path: string }[]
}

const { lang = localeOf(Astro.url.pathname) } = Astro.props

/*
  The locale-free path, used for the nav's active state and for pointing the
  language switcher at this same page in the other language.
*/
const path = Astro.url.pathname.replace(/^\/de(?=\/|$)/, '').replace(/\/$/, '') || '/'

/*
  Most pages exist at the same path in both locales, so their hreflang set can
  be derived. Blog posts differ — a translation has its own slug — so those
  pass `alternates` explicitly.
*/
const alternates = Astro.props.alternates ?? alternatesFor(path)
const strings = t(lang)
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101215" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${strings.nav.blog} — szelcsanyi consulting`}
      href={localizePath('/rss.xml', lang)}
    />
    <Seo {...Astro.props} lang={lang} alternates={alternates} />
    <!-- Marks the document as scripted so the reveal animation can hide
         content; without JS the `.js`-gated rules never apply. -->
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="bg-bg text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-[var(--radius-card)] focus:bg-accent focus:px-4 focus:py-2 focus:font-medium focus:text-[var(--color-accent-ink)]"
    >
      {strings.nav.skipToContent}
    </a>
    <div class="flex min-h-dvh flex-col">
      <Header lang={lang} path={path} alternates={alternates} />
      <main id="main" class="flex-1">
        <slot />
      </main>
      <Footer lang={lang} path={path} alternates={alternates} />
    </div>

    <script>
      /*
        Scroll-reveal for [data-reveal] elements. One observer for the whole
        page, no framework — the elements are already in the HTML, this only
        adds the transition class as they come into view.
      */
      const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]')
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      if (reduceMotion || !('IntersectionObserver' in window)) {
        reveals.forEach((el) => el.classList.add('is-visible'))
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              entry.target.classList.add('is-visible')
              observer.unobserve(entry.target)
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        )
        reveals.forEach((el) => observer.observe(el))
      }
    </script>
  </body>
</html>
