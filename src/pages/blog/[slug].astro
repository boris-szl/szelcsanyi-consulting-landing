---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { ArrowLeft, ArrowRight } from '@lucide/astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Reveal from '@/components/Reveal.astro'
import CTABand from '@/components/CTABand.astro'
import Sources from '@/components/Sources.astro'
import KeyPoints from '@/components/KeyPoints.astro'
import Badge from '@/components/ui/Badge.astro'
import { config } from '@/config'
import { relatedPosts, tagSlug } from '@/lib/tags'
import {
  abs,
  breadcrumbs,
  formatDate,
  isoDate,
  isoDuration,
  PERSON_ID,
  BUSINESS_ID,
} from '@/lib/meta'

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  )
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      /*
        Wrap so the "next up" link never needs a second collection query, and
        stay within the post's own language — a German reader should not be
        handed an English article as the next step. Falls back to the plain
        neighbour if this is the only post in its language.
      */
      next:
        posts.find(
          (candidate, j) => j !== i && candidate.data.lang === post.data.lang && j > i,
        ) ??
        posts.find((candidate) => candidate.data.lang === post.data.lang && candidate.id !== post.id) ??
        posts[(i + 1) % posts.length],
      siblings: posts,
      translations: posts.filter(
        (other) =>
          other.id !== post.id &&
          post.data.translationKey !== undefined &&
          other.data.translationKey === post.data.translationKey,
      ),
    },
  }))
}

type Props = {
  post: CollectionEntry<'blog'>
  next: CollectionEntry<'blog'>
  siblings: CollectionEntry<'blog'>[]
  translations: CollectionEntry<'blog'>[]
}

const { post, next, siblings, translations }: Props = Astro.props
const related = relatedPosts(post, siblings)
const lang = post.data.lang
const alternates = translations.map((t) => ({
  lang: t.data.lang,
  path: `/blog/${t.id}`,
}))

/* UI strings — only the handful the post chrome needs. */
const t = {
  en: {
    all: 'All writing',
    by: 'By',
    updated: 'Updated',
    next: 'Next up',
    alsoIn: 'Also in',
    related: 'Related reading',
  },
  de: {
    all: 'Alle Beiträge',
    by: 'Von',
    updated: 'Aktualisiert',
    next: 'Als Nächstes',
    alsoIn: 'Auch auf',
    related: 'Weiterlesen',
  },
}[lang]

const LANGUAGE_NAME = { en: 'English', de: 'Deutsch' } as const
const { Content } = await render(post)

const url = abs(`/blog/${post.id}`)
/* Generated per post by ./[slug]/og.png.ts */
const ogImage = `/blog/${post.id}/og.png`
const published = isoDate(post.data.date)
const modified = post.data.updated ? isoDate(post.data.updated) : published

const jsonLd = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: post.data.title,
    description: post.data.excerpt,
    url,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    datePublished: published,
    dateModified: modified,
    timeRequired: isoDuration(post.data.readingTime),
    keywords: post.data.tags,
    articleSection: post.data.tags[0],
    inLanguage: lang,
    author: { '@id': PERSON_ID },
    publisher: { '@id': BUSINESS_ID },
    image: abs(ogImage),
    isAccessibleForFree: true,
    ...(post.data.keyPoints.length
      ? { abstract: post.data.keyPoints.join(' ') }
      : {}),
    /*
      `citation` is what lets an answer engine trace a claim in this post back
      to the primary document rather than back to the post itself.
    */
    citation: post.data.sources.map((source) => ({
      '@type': 'CreativeWork',
      name: source.title,
      url: source.url,
      ...(source.publisher
        ? { publisher: { '@type': 'Organization', name: source.publisher } }
        : {}),
    })),
  },
  breadcrumbs([
    { name: 'Writing', path: '/blog' },
    { name: post.data.title, path: `/blog/${post.id}` },
  ]),
]

if (alternates.length > 0) {
  // Let the graph state the translation relationship too, not just hreflang.
  ;(jsonLd[0] as Record<string, unknown>).workTranslation = alternates.map((alt) => ({
    '@type': 'BlogPosting',
    '@id': `${abs(alt.path)}#article`,
    inLanguage: alt.lang,
  }))
}
---

<BaseLayout
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.seoDescription ?? post.data.excerpt}
  ogType="article"
  image={ogImage}
  jsonLd={jsonLd}
  article={{ publishedTime: published, modifiedTime: modified, tags: post.data.tags }}
  lang={lang}
  alternates={alternates}
>
  <article>
    <header class="border-b border-line">
      <div class="mx-auto max-w-3xl px-5 py-14 sm:px-8 lg:py-20">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-ink"
        >
          <ArrowLeft class="size-4" /> {t.all}
        </a>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <time class="mono-label text-accent" datetime={published}>
            {formatDate(post.data.date)}
          </time>
          <span class="h-px w-6 bg-line"></span>
          <span class="mono-label">{post.data.readingTime}</span>
          {
            post.data.updated && (
              <>
                <span class="h-px w-6 bg-line" />
                <span class="mono-label">{t.updated} {formatDate(post.data.updated)}</span>
              </>
            )
          }
        </div>
        <h1 class="mt-5 font-display text-4xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-5xl">
          {post.data.title}
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-muted">{post.data.excerpt}</p>

        <p class="mt-6 text-sm text-muted">
          {t.by} <a href="/about" class="font-medium text-ink hover:text-accent" rel="author">
            {config.owner}</a
          > — {config.role}{post.data.firstHand ? ' · first-hand account' : ''}
        </p>

        <div class="mt-6 flex flex-wrap gap-2">
          {
            post.data.tags.map((tag) =>
              /* German tags have no archive of their own — see lib/tags.ts. */
              post.data.lang === 'en' ? (
                <a href={`/blog/tag/${tagSlug(tag)}`} class="transition-opacity hover:opacity-80">
                  <Badge>{tag}</Badge>
                </a>
              ) : (
                <Badge>{tag}</Badge>
              ),
            )
          }
        </div>

        {
          translations.length > 0 && (
            <p class="mt-6 text-sm text-muted">
              {t.alsoIn}{' '}
              {translations.map((other) => (
                <a
                  href={`/blog/${other.id}`}
                  hreflang={other.data.lang}
                  lang={other.data.lang}
                  class="font-medium text-ink underline underline-offset-4 hover:text-accent"
                >
                  {LANGUAGE_NAME[other.data.lang]}
                </a>
              ))}
            </p>
          )
        }
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-5 py-14 sm:px-8">
      <KeyPoints points={post.data.keyPoints} lang={lang} />

      <div class="prose-datasheet">
        <Content />
      </div>

      <Sources sources={post.data.sources} lang={lang} />
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="border-t border-line">
        <div class="mx-auto max-w-3xl px-5 py-12 sm:px-8">
          <Reveal>
            <span class="mono-label">{t.related}</span>
            <div class="mt-6 flex flex-col divide-y divide-line border-y border-line">
              {related.map((other) => (
                <a
                  href={`/blog/${other.id}`}
                  class="group grid gap-2 py-5 transition-colors hover:bg-surface sm:grid-cols-[1fr_auto] sm:items-center sm:gap-6"
                >
                  <div>
                    <div class="font-display text-lg font-semibold leading-snug text-ink group-hover:text-accent">
                      {other.data.title}
                    </div>
                    <p class="mt-1 text-sm leading-relaxed text-muted">{other.data.excerpt}</p>
                  </div>
                  <span class="mono-label whitespace-nowrap">{other.data.readingTime}</span>
                </a>
              ))}
            </div>
          </Reveal>
        </div>
      </section>
    )
  }

  <section class="border-t border-line bg-surface">
    <div class="mx-auto max-w-3xl px-5 py-10 sm:px-8">
      <Reveal>
        <a href={`/blog/${next.id}`} class="group flex items-center justify-between gap-4">
          <div>
            <span class="mono-label">{t.next}</span>
            <div class="mt-1 font-display text-xl font-semibold text-ink group-hover:text-accent">
              {next.data.title}
            </div>
          </div>
          <ArrowRight
            class="size-6 shrink-0 text-muted transition-transform group-hover:translate-x-1 group-hover:text-accent"
          />
        </a>
      </Reveal>
    </div>
  </section>

  <CTABand />
</BaseLayout>
