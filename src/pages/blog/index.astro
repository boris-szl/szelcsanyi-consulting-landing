---
import { getCollection } from 'astro:content'
import { ArrowRight } from '@lucide/astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeader from '@/components/PageHeader.astro'
import Reveal from '@/components/Reveal.astro'
import CTABand from '@/components/CTABand.astro'
import Badge from '@/components/ui/Badge.astro'
import { config } from '@/config'
import { abs, breadcrumbs, formatDate, isoDate, PERSON_ID, BUSINESS_ID } from '@/lib/meta'

const all = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)

/*
  One row per article, not per translation. Posts sharing a translationKey are
  the same piece of writing, so list the English one (this page is lang="en")
  and link the other language from that row. Without this the index showed the
  same article twice, which also reads to a crawler as near-duplicate content.
*/
const translationsOf = (post: (typeof all)[number]) =>
  post.data.translationKey
    ? all.filter(
        (other) => other.id !== post.id && other.data.translationKey === post.data.translationKey,
      )
    : []

const seen = new Set<string>()
const posts = all.filter((post) => {
  const key = post.data.translationKey
  if (!key) return true
  // Prefer the English version as the canonical row for this article.
  if (post.data.lang !== 'en' && all.some((o) => o.data.translationKey === key && o.data.lang === 'en'))
    return false
  if (seen.has(key)) return false
  seen.add(key)
  return true
})

const description =
  'Field notes on building dependable systems, React Native, reading slow queries, and consulting that leaves a team stronger.'

const jsonLd = [
  {
    '@type': 'Blog',
    '@id': `${abs('/blog')}#blog`,
    url: abs('/blog'),
    name: `Writing — ${config.brandFull}`,
    description,
    inLanguage: 'en',
    publisher: { '@id': BUSINESS_ID },
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      '@id': `${abs(`/blog/${post.id}`)}#article`,
      headline: post.data.title,
      url: abs(`/blog/${post.id}`),
      datePublished: isoDate(post.data.date),
      description: post.data.excerpt,
      keywords: post.data.tags,
      author: { '@id': PERSON_ID },
    })),
  },
  breadcrumbs([{ name: 'Writing', path: '/blog' }]),
]
---

<BaseLayout title="Writing" description={description} jsonLd={jsonLd}>
  <PageHeader
    eyebrowRef="§ WRITING"
    eyebrow="Writing"
    title="Notes from the work."
    intro="Field notes on building dependable systems, reading slow queries, and doing consulting that actually leaves a team stronger."
  />

  <section class="mx-auto max-w-4xl px-5 py-14 sm:px-8">
    <div class="border-t border-line">
      {
        posts.map((post, i) => (
          <Reveal delay={i * 60}>
            <a
              href={`/blog/${post.id}`}
              class="group grid gap-3 border-b border-line py-8 transition-colors hover:bg-surface sm:grid-cols-[9rem_1fr] sm:gap-8"
            >
              <div class="flex flex-col gap-1">
                <time class="mono-label" datetime={isoDate(post.data.date)}>
                  {formatDate(post.data.date)}
                </time>
                <span class="mono-label">{post.data.readingTime}</span>
              </div>
              <div>
                <h2 class="font-display text-2xl font-semibold leading-snug text-ink group-hover:text-accent">
                  {post.data.title}
                </h2>
                <p class="mt-3 max-w-2xl leading-relaxed text-muted">{post.data.excerpt}</p>
                <div class="mt-5 flex flex-wrap items-center gap-2">
                  {post.data.tags.map((tag) => (
                    <Badge>{tag}</Badge>
                  ))}
                  {post.data.sources.length > 0 && (
                    <Badge variant="plain">
                      {post.data.sources.length} sources
                    </Badge>
                  )}
                  {/* The index is an English page; flag anything that is not. */}
                  {post.data.lang !== 'en' && (
                    <Badge variant="solid">{post.data.lang.toUpperCase()}</Badge>
                  )}
                  {translationsOf(post).map((other) => (
                    <Badge variant="solid">
                      {other.data.lang === 'de' ? 'Auch auf Deutsch' : other.data.lang.toUpperCase()}
                    </Badge>
                  ))}
                  <span class="ml-auto hidden items-center gap-1 text-sm font-medium text-ink sm:inline-flex">
                    Read
                    <ArrowRight class="size-4 transition-transform group-hover:translate-x-0.5" />
                  </span>
                </div>
              </div>
            </a>
          </Reveal>
        ))
      }
    </div>
  </section>

  <CTABand />
</BaseLayout>
