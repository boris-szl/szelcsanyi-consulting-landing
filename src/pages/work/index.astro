---
import { ArrowUpRight } from '@lucide/astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeader from '@/components/PageHeader.astro'
import Reveal from '@/components/Reveal.astro'
import CTABand from '@/components/CTABand.astro'
import Badge from '@/components/ui/Badge.astro'
import { projects } from '@/lib/content'
import { abs, breadcrumbs, WEBSITE_ID } from '@/lib/meta'

const description =
  'Ventures I’ve founded, led, and advised across security-tech, marketplaces, and edtech — OnDuty, Nisura, BookSecurity, Yükbul, and more.'

const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': `${abs('/work')}#page`,
    url: abs('/work'),
    name: 'Work',
    description,
    isPartOf: { '@id': WEBSITE_ID },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: projects.map((project, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: abs(`/work/${project.slug}`),
        name: project.name,
      })),
    },
  },
  breadcrumbs([{ name: 'Work', path: '/work' }]),
]
---

<BaseLayout title="Work" description={description} jsonLd={jsonLd}>
  <PageHeader
    eyebrowRef="§ WORK"
    eyebrow="Portfolio"
    title="The products I’ve founded, led, and advised."
    intro="Real ventures across security-tech, marketplaces, and edtech — in the EU, the UAE, and Turkey. Some I run as CTO; others I steer as an advisor."
  />

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      {
        projects.map((project, i) => (
          <Reveal delay={(i % 2) * 80}>
            <a
              href={`/work/${project.slug}`}
              class="group flex h-full flex-col rounded-[var(--radius-card)] border border-line bg-surface p-7 transition-colors hover:border-line-strong"
            >
              <div class="flex items-center justify-between">
                <span class="mono-label text-accent">{project.ref}</span>
                <Badge variant={project.status === 'Advisory' ? 'default' : 'accent'}>
                  {project.status}
                </Badge>
              </div>

              <div class="mt-6 flex items-baseline justify-between gap-4">
                <h2 class="font-display text-2xl font-semibold text-ink group-hover:text-accent">
                  {project.name}
                </h2>
                <span class="mono-label whitespace-nowrap">{project.period}</span>
              </div>

              <p class="mt-1 text-sm font-medium text-accent">{project.role}</p>
              <p class="mt-4 font-display text-lg italic text-ink/80">“{project.tagline}”</p>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{project.summary}</p>

              <div class="mt-6 flex flex-wrap items-center gap-2">
                {project.stack.slice(0, 4).map((tech) => (
                  <Badge>{tech}</Badge>
                ))}
              </div>

              <span class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-ink">
                Read the case
                <ArrowUpRight class="size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
              </span>
            </a>
          </Reveal>
        ))
      }
    </div>
  </section>

  <CTABand />
</BaseLayout>
