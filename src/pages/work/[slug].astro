---
import { ArrowLeft, ArrowRight, ArrowUpRight } from '@lucide/astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Reveal from '@/components/Reveal.astro'
import CTABand from '@/components/CTABand.astro'
import Button from '@/components/ui/Button.astro'
import Badge from '@/components/ui/Badge.astro'
import { projects } from '@/lib/content'
import { abs, breadcrumbs, PERSON_ID } from '@/lib/meta'

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }))
}

const { project, next } = Astro.props

const sections: [string, string, string][] = [
  ['01', 'The problem', project.problem],
  ['02', 'What I did', project.work],
  ['03', 'The outcome', project.outcome],
]

const facts: [string, string][] = [
  ['role', project.role],
  ['period', project.period],
  ['status', project.status],
  ['domain', project.domain],
]

const url = abs(`/work/${project.slug}`)
const jsonLd = [
  {
    '@type': 'CreativeWork',
    '@id': `${url}#project`,
    name: project.name,
    headline: `${project.name} — ${project.role}`,
    description: project.summary,
    abstract: project.tagline,
    url,
    about: project.domain,
    creator: { '@id': PERSON_ID },
    keywords: project.stack,
    inLanguage: 'en',
    ...(project.url ? { sameAs: [project.url] } : {}),
  },
  breadcrumbs([
    { name: 'Work', path: '/work' },
    { name: project.name, path: `/work/${project.slug}` },
  ]),
]
---

<BaseLayout
  title={`${project.name} — ${project.role}`}
  description={project.summary}
  ogType="article"
  jsonLd={jsonLd}
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-4xl px-5 py-14 sm:px-8 lg:py-20">
      <a
        href="/work"
        class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-ink"
      >
        <ArrowLeft class="size-4" /> All work
      </a>

      <Reveal class="mt-8">
        <div class="flex items-center gap-3">
          <span class="mono-label text-accent">{project.ref}</span>
          <Badge variant={project.status === 'Advisory' ? 'default' : 'accent'}>
            {project.status}
          </Badge>
        </div>
        <h1 class="mt-5 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
          {project.name}
        </h1>
        <p class="mt-4 font-display text-xl italic text-ink/80">“{project.tagline}”</p>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{project.summary}</p>
        <Button
          href={project.url}
          target="_blank"
          rel="noopener"
          variant="outline"
          class="mt-7"
        >
          Visit {project.name} <ArrowUpRight class="size-4" />
        </Button>
      </Reveal>
    </div>
  </section>

  <div class="mx-auto grid max-w-4xl gap-12 px-5 py-16 sm:px-8 lg:grid-cols-[1fr_16rem] lg:gap-16">
    <div class="order-2 lg:order-1">
      {
        sections.map(([num, heading, body]) => (
          <Reveal class="border-t border-line py-8 first:border-t-0 first:pt-0">
            <div class="flex items-baseline gap-3">
              <span class="mono-label text-accent">§{num}</span>
              <h2 class="font-display text-2xl font-semibold text-ink">{heading}</h2>
            </div>
            <p class="mt-4 leading-relaxed text-muted">{body}</p>
          </Reveal>
        ))
      }
    </div>

    <aside class="order-1 lg:order-2">
      <div class="sticky top-24 rounded-[var(--radius-card)] border border-line bg-surface">
        <div class="border-b border-line px-5 py-3">
          <span class="mono-label">datasheet</span>
        </div>
        <dl class="divide-y divide-line">
          {
            facts.map(([key, value]) => (
              <div class="px-5 py-3">
                <dt class="mono-label">{key}</dt>
                <dd class="mt-1 text-sm font-medium text-ink">{value}</dd>
              </div>
            ))
          }
        </dl>
        <div class="border-t border-line px-5 py-4">
          <span class="mono-label">stack</span>
          <div class="mt-3 flex flex-wrap gap-2">
            {project.stack.map((tech) => <Badge>{tech}</Badge>)}
          </div>
        </div>
      </div>
    </aside>
  </div>

  <section class="border-t border-line bg-surface">
    <div class="mx-auto max-w-4xl px-5 py-10 sm:px-8">
      <a href={`/work/${next.slug}`} class="group flex items-center justify-between gap-4">
        <div>
          <span class="mono-label">Next</span>
          <div class="mt-1 font-display text-2xl font-semibold text-ink group-hover:text-accent">
            {next.name}
          </div>
        </div>
        <ArrowRight
          class="size-6 text-muted transition-transform group-hover:translate-x-1 group-hover:text-accent"
        />
      </a>
    </div>
  </section>

  <CTABand />
</BaseLayout>
