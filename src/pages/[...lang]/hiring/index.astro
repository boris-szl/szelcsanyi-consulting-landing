---
import { ArrowUpRight, Globe } from '@lucide/astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeader from '@/components/PageHeader.astro'
import Reveal from '@/components/Reveal.astro'
import CTABand from '@/components/CTABand.astro'
import Badge from '@/components/ui/Badge.astro'
import { localizedRoles } from '@/lib/localized'
import { abs, breadcrumbs, WEBSITE_ID } from '@/lib/meta'
import { localePaths, langParam, localizePath, t } from '@/i18n'

export function getStaticPaths() {
  return localePaths()
}

const lang = langParam(Astro.params.lang)
const s = t(lang)
const roles = localizedRoles(lang)

const description =
  lang === 'de'
    ? 'Offene Positionen, die ich besetze, und weltweite Suche nach Tech-Fachkräften — aktuell OT/ICS- und IT-Infrastrukturarchitektur für KRITIS-Programme.'
    : 'Open roles I’m recruiting for, and global tech-talent search — currently OT/ICS and IT infrastructure architects for critical-infrastructure programmes.'

const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': `${abs(localizePath('/hiring', lang))}#page`,
    url: abs(localizePath('/hiring', lang)),
    name: s.nav.hiring,
    inLanguage: lang,
    description,
    isPartOf: { '@id': WEBSITE_ID },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: roles.map((role, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: abs(localizePath(`/hiring/${role.slug}`, lang)),
        name: role.title,
      })),
    },
  },
  breadcrumbs([{ name: s.nav.hiring, path: localizePath('/hiring', lang) }]),
]
---

<BaseLayout title={s.nav.hiring} description={description} lang={lang} jsonLd={jsonLd}>
  <PageHeader
    eyebrowRef="§ HIRING"
    eyebrow={s.hiring.eyebrow}
    title={s.hiring.title}
    intro={s.hiring.intro}
  />

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <Reveal>
      <div class="flex items-center gap-3">
        <Globe class="size-5 text-accent" stroke-width={1.6} />
        <span class="mono-label">{roles.length} {s.hiring.openRoles}</span>
      </div>
    </Reveal>

    <div class="mt-8 flex flex-col divide-y divide-line border-y border-line">
      {
        roles.map((role, i) => (
          <Reveal delay={i * 60}>
            <a
              href={localizePath(`/hiring/${role.slug}`, lang)}
              class="group grid gap-4 py-7 transition-colors hover:bg-surface-2/40 sm:grid-cols-[1fr_auto] sm:items-center sm:gap-8"
            >
              <div>
                <div class="flex flex-wrap items-center gap-3">
                  <span class="mono-label text-accent">{role.ref}</span>
                  <Badge variant="accent">{role.statusLabel}</Badge>
                </div>
                <h2 class="mt-3 font-display text-2xl font-semibold text-ink group-hover:text-accent">
                  {role.title}
                </h2>
                <p class="mt-1 text-sm font-medium text-accent">{role.discipline}</p>
                <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">{role.summary}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  <Badge>{role.location}</Badge>
                  <Badge>{role.type}</Badge>
                </div>
              </div>
              <ArrowUpRight class="hidden size-6 text-muted transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent sm:block" />
            </a>
          </Reveal>
        ))
      }
    </div>

    <Reveal class="mt-10">
      <p class="max-w-xl text-sm leading-relaxed text-muted">
        {s.hiring.closing}
      </p>
    </Reveal>
  </section>

  <CTABand lang={lang} />
</BaseLayout>
