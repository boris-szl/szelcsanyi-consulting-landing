---
import { ArrowUpRight } from '@lucide/astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeader from '@/components/PageHeader.astro'
import Reveal from '@/components/Reveal.astro'
import CTABand from '@/components/CTABand.astro'
import Badge from '@/components/ui/Badge.astro'
import { localizedProjects } from '@/lib/localized'
import { abs, breadcrumbs, WEBSITE_ID } from '@/lib/meta'
import { localePaths, langParam, localizePath, t } from '@/i18n'

export function getStaticPaths() {
  return localePaths()
}

const lang = langParam(Astro.params.lang)
const s = t(lang)
const projects = localizedProjects(lang)

const description =
  lang === 'de'
    ? 'Unternehmungen, die ich gegründet, geleitet und beraten habe — in Security-Tech, Marktplätzen und EdTech: OnDuty, Nisura, BookSecurity, Yükbul und mehr.'
    : 'Ventures I’ve founded, led, and advised across security-tech, marketplaces, and edtech — OnDuty, Nisura, BookSecurity, Yükbul, and more.'

const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': `${abs(localizePath('/work', lang))}#page`,
    url: abs(localizePath('/work', lang)),
    name: s.nav.work,
    inLanguage: lang,
    description,
    isPartOf: { '@id': WEBSITE_ID },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: projects.map((project, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: abs(localizePath(`/work/${project.slug}`, lang)),
        name: project.name,
      })),
    },
  },
  breadcrumbs([{ name: s.nav.work, path: localizePath('/work', lang) }]),
]
---

<BaseLayout title={s.nav.work} description={description} lang={lang} jsonLd={jsonLd}>
  <PageHeader
    eyebrowRef="§ WORK"
    eyebrow={s.work.eyebrow}
    title={s.work.title}
    intro={s.work.intro}
  />

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      {
        projects.map((project, i) => (
          <Reveal delay={(i % 2) * 80}>
            <a
              href={localizePath(`/work/${project.slug}`, lang)}
              class="group flex h-full flex-col rounded-[var(--radius-card)] border border-line bg-surface p-7 transition-colors hover:border-line-strong"
            >
              <div class="flex items-center justify-between">
                <span class="mono-label text-accent">{project.ref}</span>
                <Badge variant={project.status === 'Advisory' ? 'default' : 'accent'}>
                  {project.statusLabel}
                </Badge>
              </div>

              <div class="mt-6 flex items-baseline justify-between gap-4">
                <h2 class="font-display text-2xl font-semibold text-ink group-hover:text-accent">
                  {project.name}
                </h2>
                <span class="mono-label whitespace-nowrap">{project.period}</span>
              </div>

              <p class="mt-1 text-sm font-medium text-accent">{project.role}</p>
              <p class="mt-4 font-display text-lg italic text-ink/80">“{project.tagline}”</p>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{project.summary}</p>

              <div class="mt-6 flex flex-wrap items-center gap-2">
                {project.stack.slice(0, 4).map((tech) => (
                  <Badge>{tech}</Badge>
                ))}
              </div>

              <span class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-ink">
                {s.common.readCase}
                <ArrowUpRight class="size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
              </span>
            </a>
          </Reveal>
        ))
      }
    </div>
  </section>

  <CTABand lang={lang} />
</BaseLayout>
