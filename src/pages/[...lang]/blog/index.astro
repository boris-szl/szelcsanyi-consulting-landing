---
import { ArrowRight } from '@lucide/astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeader from '@/components/PageHeader.astro'
import Reveal from '@/components/Reveal.astro'
import CTABand from '@/components/CTABand.astro'
import Badge from '@/components/ui/Badge.astro'
import { config } from '@/config'
import { postsIn, postPath } from '@/lib/posts'
import { localePaths, langParam, localizePath, t } from '@/i18n'

export function getStaticPaths() {
  return localePaths()
}

const lang = langParam(Astro.params.lang)
const s = t(lang)
import { abs, breadcrumbs, formatDate, isoDate, PERSON_ID, BUSINESS_ID } from '@/lib/meta'

const all = await postsIn(lang)

/*
  The list is already one row per article: posts are filtered by locale, and a
  translation lives in the other locale's tree. The earlier dedup pass is gone
  because there is nothing left to dedupe.
*/
const posts = all

const description =
  lang === 'de'
    ? 'Notizen aus der Praxis: verlässliche Systeme bauen, langsame Queries lesen und beraten, sodass ein Team danach stärker dasteht.'
    : 'Field notes on building dependable systems, React Native, reading slow queries, and consulting that leaves a team stronger.'

const jsonLd = [
  {
    '@type': 'Blog',
    '@id': `${abs(localizePath('/blog', lang))}#blog`,
    url: abs(localizePath('/blog', lang)),
    name: `${s.nav.blog} — ${config.brandFull}`,
    description,
    inLanguage: lang,
    publisher: { '@id': BUSINESS_ID },
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      '@id': `${abs(postPath(post))}#article`,
      headline: post.data.title,
      url: abs(postPath(post)),
      datePublished: isoDate(post.data.date),
      description: post.data.excerpt,
      keywords: post.data.tags,
      author: { '@id': PERSON_ID },
    })),
  },
  breadcrumbs([{ name: s.nav.blog, path: localizePath('/blog', lang) }]),
]
---

<BaseLayout title={s.nav.blog} description={description} lang={lang} jsonLd={jsonLd}>
  <PageHeader
    eyebrowRef="§ WRITING"
    eyebrow={s.blog.eyebrow}
    title={s.blog.title}
    intro={s.blog.intro}
  />

  <section class="mx-auto max-w-4xl px-5 py-14 sm:px-8">
    <div class="border-t border-line">
      {
        posts.map((post, i) => (
          <Reveal delay={i * 60}>
            <a
              href={postPath(post)}
              class="group grid gap-3 border-b border-line py-8 transition-colors hover:bg-surface sm:grid-cols-[9rem_1fr] sm:gap-8"
            >
              <div class="flex flex-col gap-1">
                <time class="mono-label" datetime={isoDate(post.data.date)}>
                  {formatDate(post.data.date)}
                </time>
                <span class="mono-label">{post.data.readingTime}</span>
              </div>
              <div>
                <h2 class="font-display text-2xl font-semibold leading-snug text-ink group-hover:text-accent">
                  {post.data.title}
                </h2>
                <p class="mt-3 max-w-2xl leading-relaxed text-muted">{post.data.excerpt}</p>
                <div class="mt-5 flex flex-wrap items-center gap-2">
                  {post.data.tags.map((tag) => (
                    <Badge>{tag}</Badge>
                  ))}
                  {post.data.sources.length > 0 && (
                    <Badge variant="plain">
                      {post.data.sources.length} {s.blog.sourcesCount}
                    </Badge>
                  )}
                  <span class="ml-auto hidden items-center gap-1 text-sm font-medium text-ink sm:inline-flex">
                    {s.common.readMore}
                    <ArrowRight class="size-4 transition-transform group-hover:translate-x-0.5" />
                  </span>
                </div>
              </div>
            </a>
          </Reveal>
        ))
      }
    </div>
  </section>

  <CTABand lang={lang} />
</BaseLayout>
