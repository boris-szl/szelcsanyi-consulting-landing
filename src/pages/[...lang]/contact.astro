---
import { ArrowUpRight } from '@lucide/astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeader from '@/components/PageHeader.astro'
import Reveal from '@/components/Reveal.astro'
import StatusBadge from '@/components/StatusBadge.astro'
import { BookingEmbed } from '@/components/BookingEmbed'
import { site } from '@/lib/site'
import { config, formattedAddress } from '@/config'
import { abs, breadcrumbs, BUSINESS_ID, WEBSITE_ID } from '@/lib/meta'
import { localePaths, langParam, localizePath, t } from '@/i18n'

export function getStaticPaths() {
  return localePaths()
}

const lang = langParam(Astro.params.lang)
const s = t(lang)

const description =
  lang === 'de'
    ? 'Projekt starten mit Boris Szelcsányi — Fractional CTO, Backend und React-Native-Apps. Standort Wien & St. Gallen, Arbeitsweise remote-first.'
    : 'Start a project with Boris Szelcsányi — fractional CTO, backend, and React Native mobile. Based in Vienna & St. Gallen, working remote-first.'

const url = abs(localizePath('/contact', lang))
const jsonLd = [
  {
    '@type': 'ContactPage',
    '@id': `${url}#page`,
    url,
    name: s.contact.title,
    description,
    inLanguage: lang,
    isPartOf: { '@id': WEBSITE_ID },
    mainEntity: { '@id': BUSINESS_ID },
  },
  {
    '@type': 'ContactPoint',
    '@id': `${url}#contactpoint`,
    contactType: lang === 'de' ? 'Vertrieb und neue Mandate' : 'Sales and new engagements',
    email: `mailto:${config.email}`,
    availableLanguage: ['English', 'German'],
    areaServed: ['CH', 'AT', 'DE', 'EU'],
  },
  breadcrumbs([{ name: s.nav.contact, path: localizePath('/contact', lang) }]),
]

const facts: [string, string][] = [
  [s.contact.basedIn, `${s.common.location} · ${site.timezone}`],
  [s.contact.registeredOffice, formattedAddress],
  [s.contact.workingStyle, s.contact.workingStyleValue],
]
---

<BaseLayout title={s.contact.title} description={description} lang={lang} jsonLd={jsonLd}>
  <PageHeader
    eyebrowRef="§ CONTACT"
    eyebrow={s.contact.eyebrow}
    title={s.contact.title}
    intro={s.contact.intro}
  />

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr]">
      <Reveal>
        {/*
          The booker is a third-party iframe with no useful server-rendered
          form, so it is mounted client-side only. The details panel beside it
          carries the real contact routes in static HTML.
        */}
        <BookingEmbed client:only="react">
          <div
            slot="fallback"
            class="flex min-h-[28rem] flex-col items-start justify-center gap-3 rounded-[var(--radius-card)] border border-line bg-surface px-6 py-16 sm:px-10"
          >
            <span class="mono-label text-accent">{s.contact.booking}</span>
            <p class="max-w-md leading-relaxed text-muted">
              {s.contact.bookingFallback}{' '}
              <a class="text-ink underline underline-offset-4" href={site.social.email}>
                {site.email}
              </a>{' '}
              {s.contact.bookingFallbackTail}
            </p>
          </div>
        </BookingEmbed>
      </Reveal>

      <Reveal delay={120}>
        <div class="rounded-[var(--radius-card)] border border-line bg-surface">
          <div class="border-b border-line px-6 py-4">
            <StatusBadge lang={lang} />
          </div>
          <dl class="divide-y divide-line">
            <div class="px-6 py-4">
              <dt class="mono-label">{s.contact.email}</dt>
              <dd class="mt-1">
                <a
                  href={site.social.email}
                  class="inline-flex items-center gap-1 text-sm font-medium text-ink hover:text-accent"
                >
                  {site.email}
                </a>
              </dd>
            </div>
            {
              facts.map(([label, value]) => (
                <div class="px-6 py-4">
                  <dt class="mono-label">{label}</dt>
                  <dd class="mt-1 text-sm font-medium text-ink">{value}</dd>
                </div>
              ))
            }
            <div class="px-6 py-4">
              <dt class="mono-label">{s.contact.elsewhere}</dt>
              <dd class="mt-2 flex flex-col gap-2">
                <a
                  href={site.social.linkedin}
                  rel="me noopener"
                  class="inline-flex items-center gap-1 text-sm text-muted hover:text-ink"
                >
                  LinkedIn <ArrowUpRight class="size-3.5" />
                </a>
                <a
                  href={site.social.github}
                  rel="me noopener"
                  class="inline-flex items-center gap-1 text-sm text-muted hover:text-ink"
                >
                  GitHub <ArrowUpRight class="size-3.5" />
                </a>
              </dd>
            </div>
          </dl>
        </div>
      </Reveal>
    </div>
  </section>
</BaseLayout>
