---
import { ArrowLeft, Check } from '@lucide/astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Reveal from '@/components/Reveal.astro'
import Button from '@/components/ui/Button.astro'
import Badge from '@/components/ui/Badge.astro'
import { roles } from '@/lib/roles'
import { site } from '@/lib/site'
import { abs, breadcrumbs, BUSINESS_ID } from '@/lib/meta'

export function getStaticPaths() {
  return roles.map((role, i) => ({
    params: { slug: role.slug },
    props: { role, next: roles[(i + 1) % roles.length] },
  }))
}

const { role, next } = Astro.props

const applySubject = encodeURIComponent(`Application — ${role.title} (${role.ref})`)
const applyHref = `${site.social.email}?subject=${applySubject}`

const facts: [string, string][] = [
  ['role', role.ref],
  ['discipline', role.discipline],
  ['location', role.location],
  ['type', role.type],
  ['client', role.client],
  ['status', role.status],
]

const bulletGroups: { heading: string; note?: string; items: string[]; marker: 'check' | 'dash' }[] =
  [
    { heading: 'What you’ll do', items: role.responsibilities, marker: 'dash' },
    { heading: 'What you need', note: 'must-have', items: role.mustHave, marker: 'check' },
    { heading: 'What helps', note: 'nice-to-have', items: role.niceToHave, marker: 'dash' },
    { heading: 'What’s on offer', items: role.offer, marker: 'dash' },
  ]

const url = abs(`/hiring/${role.slug}`)
const jsonLd = [
  {
    '@type': 'JobPosting',
    '@id': `${url}#job`,
    title: role.title,
    description: [role.summary, ...role.about].join(' '),
    url,
    employmentType: /full-time/i.test(role.type) ? 'FULL_TIME' : 'CONTRACTOR',
    occupationalCategory: role.discipline,
    industry: role.discipline,
    hiringOrganization: { '@id': BUSINESS_ID },
    ...(/remote|hybrid/i.test(role.location) ? { jobLocationType: 'TELECOMMUTE' } : {}),
    applicantLocationRequirements: { '@type': 'Country', name: 'Europe' },
    jobLocation: {
      '@type': 'Place',
      address: {
        '@type': 'PostalAddress',
        addressRegion: role.location,
        addressCountry: 'EU',
      },
    },
    responsibilities: role.responsibilities.join('; '),
    qualifications: role.mustHave.join('; '),
    skills: [...role.mustHave, ...role.niceToHave].join('; '),
    jobBenefits: role.offer.join('; '),
    directApply: true,
  },
  breadcrumbs([
    { name: 'Hiring', path: '/hiring' },
    { name: role.title, path: `/hiring/${role.slug}` },
  ]),
]
---

<BaseLayout
  title={`${role.title} — Hiring`}
  description={role.summary}
  ogType="article"
  jsonLd={jsonLd}
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-4xl px-5 py-14 sm:px-8 lg:py-20">
      <a
        href="/hiring"
        class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-ink"
      >
        <ArrowLeft class="size-4" /> All roles
      </a>

      <Reveal class="mt-8">
        <div class="flex items-center gap-3">
          <span class="mono-label text-accent">{role.ref}</span>
          <Badge variant="accent">{role.status}</Badge>
        </div>
        <h1 class="mt-5 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
          {role.title}
        </h1>
        <p class="mt-3 font-display text-lg text-accent">{role.discipline}</p>
        <div class="mt-5 flex flex-wrap gap-2">
          <Badge>{role.location}</Badge>
          <Badge>{role.type}</Badge>
        </div>
        <Button href={applyHref} size="lg" class="mt-7">Apply for this role</Button>
      </Reveal>
    </div>
  </section>

  <div class="mx-auto grid max-w-4xl gap-12 px-5 py-16 sm:px-8 lg:grid-cols-[1fr_16rem] lg:gap-16">
    <div class="order-2 lg:order-1">
      <Reveal>
        <h2 class="font-display text-xl font-semibold text-ink">About the role</h2>
        {role.about.map((paragraph) => <p class="mt-4 leading-relaxed text-muted">{paragraph}</p>)}
        {
          role.note && (
            <p class="mt-5 rounded-[var(--radius-card)] border border-accent/25 bg-accent/[0.06] p-4 text-sm leading-relaxed text-ink/90">
              {role.note}
            </p>
          )
        }
      </Reveal>

      {
        bulletGroups.map((group) => (
          <Reveal class="mt-10 border-t border-line pt-8">
            <h2 class="font-display text-xl font-semibold text-ink">
              {group.heading}
              {group.note && <span class="mono-label align-middle"> {group.note}</span>}
            </h2>
            <ul class="mt-4 flex flex-col gap-2.5">
              {group.items.map((item) => (
                <li class="flex gap-3 text-sm leading-relaxed text-muted">
                  {group.marker === 'check' ? (
                    <Check class="mt-0.5 size-4 shrink-0 text-accent" />
                  ) : (
                    <span class="mt-2 h-px w-3 shrink-0 bg-accent" />
                  )}
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </Reveal>
        ))
      }

      <Reveal class="mt-10 rounded-[var(--radius-card)] border border-line bg-surface p-7">
        <h2 class="font-display text-xl font-semibold text-ink">How to apply</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Send your CV and a line on why this role fits. Meeting most of the must-haves is
          enough — apply. All approaches are handled confidentially.
        </p>
        <Button href={applyHref} class="mt-5">Apply — {site.email}</Button>
      </Reveal>
    </div>

    <aside class="order-1 lg:order-2">
      <div class="sticky top-24 rounded-[var(--radius-card)] border border-line bg-surface">
        <div class="border-b border-line px-5 py-3">
          <span class="mono-label">role spec</span>
        </div>
        <dl class="divide-y divide-line">
          {
            facts.map(([key, value]) => (
              <div class="px-5 py-3">
                <dt class="mono-label">{key}</dt>
                <dd class="mt-1 text-sm font-medium text-ink">{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </aside>
  </div>

  <section class="border-t border-line bg-surface">
    <div class="mx-auto max-w-4xl px-5 py-10 sm:px-8">
      <a href={`/hiring/${next.slug}`} class="group flex items-center justify-between gap-4">
        <div>
          <span class="mono-label">Next role</span>
          <div class="mt-1 font-display text-xl font-semibold text-ink group-hover:text-accent">
            {next.title}
          </div>
        </div>
        <ArrowLeft
          class="size-6 rotate-180 text-muted transition-transform group-hover:translate-x-1 group-hover:text-accent"
        />
      </a>
    </div>
  </section>
</BaseLayout>
