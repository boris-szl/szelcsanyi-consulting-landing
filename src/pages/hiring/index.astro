---
import { ArrowUpRight, Globe } from '@lucide/astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeader from '@/components/PageHeader.astro'
import Reveal from '@/components/Reveal.astro'
import CTABand from '@/components/CTABand.astro'
import Badge from '@/components/ui/Badge.astro'
import { roles } from '@/lib/roles'
import { abs, breadcrumbs, WEBSITE_ID } from '@/lib/meta'

const description =
  'Open roles I’m recruiting for, and global tech-talent search — currently OT/ICS and IT infrastructure architects for critical-infrastructure programmes.'

const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': `${abs('/hiring')}#page`,
    url: abs('/hiring'),
    name: 'Hiring',
    description,
    isPartOf: { '@id': WEBSITE_ID },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: roles.map((role, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: abs(`/hiring/${role.slug}`),
        name: role.title,
      })),
    },
  },
  breadcrumbs([{ name: 'Hiring', path: '/hiring' }]),
]
---

<BaseLayout title="Hiring" description={description} jsonLd={jsonLd}>
  <PageHeader
    eyebrowRef="§ HIRING"
    eyebrow="Recruiting"
    title="I place senior tech talent — globally."
    intro="Alongside building, I recruit hard-to-find engineers and architects worldwide. These are the searches I’m running right now."
  />

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <Reveal>
      <div class="flex items-center gap-3">
        <Globe class="size-5 text-accent" stroke-width={1.6} />
        <span class="mono-label">{roles.length} open roles · worldwide</span>
      </div>
    </Reveal>

    <div class="mt-8 flex flex-col divide-y divide-line border-y border-line">
      {
        roles.map((role, i) => (
          <Reveal delay={i * 60}>
            <a
              href={`/hiring/${role.slug}`}
              class="group grid gap-4 py-7 transition-colors hover:bg-surface-2/40 sm:grid-cols-[1fr_auto] sm:items-center sm:gap-8"
            >
              <div>
                <div class="flex flex-wrap items-center gap-3">
                  <span class="mono-label text-accent">{role.ref}</span>
                  <Badge variant="accent">{role.status}</Badge>
                </div>
                <h2 class="mt-3 font-display text-2xl font-semibold text-ink group-hover:text-accent">
                  {role.title}
                </h2>
                <p class="mt-1 text-sm font-medium text-accent">{role.discipline}</p>
                <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">{role.summary}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  <Badge>{role.location}</Badge>
                  <Badge>{role.type}</Badge>
                </div>
              </div>
              <ArrowUpRight class="hidden size-6 text-muted transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent sm:block" />
            </a>
          </Reveal>
        ))
      }
    </div>

    <Reveal class="mt-10">
      <p class="max-w-xl text-sm leading-relaxed text-muted">
        Hiring for something else — or looking for your next role? I keep a global network of
        senior engineers and architects. Reach out and tell me what you need.
      </p>
    </Reveal>
  </section>

  <CTABand />
</BaseLayout>
