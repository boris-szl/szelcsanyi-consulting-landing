# Cal.com Platform OAuth client — required for the <BookerEmbed /> on /contact.
# Create it in the Cal.com Platform dashboard (paid Platform plan) and copy the
# client ID here. Without it the contact page falls back to a link to the public
# cal.com booking page.
VITE_CAL_CLIENT_ID=

# Cal.com API base. Only change this if you self-host Cal.com.
VITE_CAL_API_URL=https://api.cal.com/v2
